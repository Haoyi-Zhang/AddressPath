(set-logic QF_LIA)
(declare-const ddt0 Int)
(assert (<= 0 ddt0))
(assert (<= ddt0 1))
(declare-const ddt1 Int)
(assert (<= 0 ddt1))
(assert (<= ddt1 1))
(declare-const pdt0 Int)
(assert (<= 0 pdt0))
(assert (<= pdt0 1))
(declare-const pdt1 Int)
(assert (<= 0 pdt1))
(assert (<= pdt1 1))
(declare-const ret0 Int)
(assert (<= 1 ret0))
(assert (<= ret0 1))
(declare-const ret1 Int)
(assert (<= 1 ret1))
(assert (<= ret1 1))
(declare-const xlate0 Int)
(assert (<= 0 xlate0))
(assert (<= xlate0 1))
(declare-const xlate1 Int)
(assert (<= 0 xlate1))
(assert (<= xlate1 1))
(assert (<= (+ ddt0 pdt0 xlate0) 2))
(assert (<= (+ ddt1 pdt1 xlate1) 2))
(assert (or (and (= ddt0 1) (= pdt0 1) (= xlate0 1) (= ret0 1) (= ret0 1)) (and (= ddt1 1) (= pdt1 1) (= xlate1 1) (= ret1 1) (= ret1 1))))
(check-sat)
(get-model)
