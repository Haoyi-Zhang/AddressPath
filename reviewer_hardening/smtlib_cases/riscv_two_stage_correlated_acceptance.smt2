(set-logic QF_LIA)
(declare-const commit_a Int)
(assert (<= 1 commit_a))
(assert (<= commit_a 1))
(declare-const commit_b Int)
(assert (<= 1 commit_b))
(assert (<= commit_b 1))
(declare-const g_a Int)
(assert (<= 0 g_a))
(assert (<= g_a 1))
(declare-const g_b Int)
(assert (<= 0 g_b))
(assert (<= g_b 1))
(declare-const vs_a Int)
(assert (<= 0 vs_a))
(assert (<= vs_a 1))
(declare-const vs_b Int)
(assert (<= 0 vs_b))
(assert (<= vs_b 1))
(assert (<= (+ g_a vs_a) 1))
(assert (<= (+ g_b vs_b) 1))
(assert (or (and (= vs_a 1) (= g_a 1) (= commit_a 1) (= commit_a 1)) (and (= vs_b 1) (= g_b 1) (= commit_b 1) (= commit_b 1))))
(check-sat)
(get-model)
