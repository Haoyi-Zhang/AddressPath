(set-logic QF_LIA)
(declare-const commit Int)
(assert (<= 1 commit))
(assert (<= commit 1))
(declare-const l0 Int)
(assert (<= 1 l0))
(assert (<= l0 1))
(declare-const l1 Int)
(assert (<= 1 l1))
(assert (<= l1 1))
(declare-const l2 Int)
(assert (<= 1 l2))
(assert (<= l2 1))
(declare-const perm Int)
(assert (<= 0 perm))
(assert (<= perm 1))
(assert (<= perm 0))
(assert (and (= l2 1) (= l1 1) (= l0 1) (= perm 1) (= commit 1) (= commit 1)))
(check-sat)
(get-model)
