(set-logic QF_LIA)
(declare-const mem Int)
(assert (<= 0 mem))
(assert (<= mem 1))
(declare-const perm Int)
(assert (<= 0 perm))
(assert (<= perm 1))
(declare-const pte Int)
(assert (<= 0 pte))
(assert (<= pte 1))
(declare-const req Int)
(assert (<= 1 req))
(assert (<= req 1))
(declare-const resp Int)
(assert (<= 1 resp))
(assert (<= resp 1))
(assert (<= (+ mem perm pte) 2))
(assert (and (= req 1) (= mem 1) (= pte 1) (= perm 1) (= resp 1)))
(check-sat)
(get-model)
